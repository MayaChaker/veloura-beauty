# Copy to .env and adjust. .env is read by Next.js and by the Prisma CLI, and is never committed.

# Postgres connection. Locally: `docker compose up -d` starts a database with these credentials.
# On Vercel it comes from the Neon integration.
DATABASE_URL=postgresql://veloura:veloura@localhost:5432/veloura

# The variables below are optional.

# Server endpoint that creates a hosted payment session (e.g. Stripe Checkout).
# It receives { items: [{ productId, variantId, quantity }], contact, shipping, promoCode }
# and returns either { "redirectUrl": "https://..." } or a confirmed order object.
# Leave empty to run checkout in demo mode.
NEXT_PUBLIC_CHECKOUT_URL=

# Customer-care address shown in the footer and policy pages.
NEXT_PUBLIC_CONTACT_EMAIL=care@velourabeauty.com

# Public origin of the deployed site, used for absolute Open Graph image URLs.
# Production builds read it from .env.production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

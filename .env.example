# Copy to .env and adjust. .env is read by Next.js and by the Prisma CLI, and is never committed.

# Postgres connection. Locally: `docker compose up -d` starts a database with these credentials.
# 127.0.0.1 rather than localhost: on Windows with WSL, localhost can resolve to a WSL port.
# On Vercel it comes from the Neon integration.
DATABASE_URL=postgresql://veloura:veloura@127.0.0.1:5432/veloura

# Accounts. The secret signs session cookies: generate one with `npx @better-auth/cli secret`
# and never reuse it between environments. The URL is the site's own address.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# The variables below are optional.

# Order confirmation emails (resend.com). Without a key, orders still work and the email is
# skipped. Without a verified domain, Resend only delivers to the account's own address.
RESEND_API_KEY=
EMAIL_FROM=Veloura <onboarding@resend.dev>

# Customer-care address shown in the footer and policy pages.
NEXT_PUBLIC_CONTACT_EMAIL=care@velourabeauty.com

# Public origin of the deployed site, used for absolute Open Graph image URLs.
# Production builds read it from .env.production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

// The store's database. Change it here, then create a migration:
//   npx prisma migrate dev --name <what-changed>
// Money is stored in whole cents (Int), never as decimals.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  Makeup
  Skincare
  Fragrance
  Hair
  Sets
}

model Brand {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String    @unique
  products Product[]
}

model Product {
  /// Kept from the catalogue files: bags saved in shoppers' browsers refer to these ids.
  id                 Int       @id
  slug               String    @unique
  name               String
  brand              Brand     @relation(fields: [brandId], references: [id])
  brandId            Int
  category           Category
  /// Slug from src/data/subcategories.ts, e.g. "lips".
  subcategory        String?
  priceCents         Int
  originalPriceCents Int?
  size               String
  badge              String?
  isNew              Boolean   @default(false)
  isBestseller       Boolean   @default(false)
  note               String
  description        String
  ingredients        String
  benefits           String[]
  texture            String
  finish             String
  ritual             String
  /// Where it sits in a routine, e.g. "Complexion · Base".
  routineStep        String
  matches            String[]
  /// Packaging drawn by the SVG fallback (see src/components/product-art).
  type               String
  packaging          String?
  color              String
  /// For sets: the ids of the products inside.
  includes           Int[]     @default([])
  /// Null when the product has shades: each shade then has its own stock.
  stock              Int?
  image              String?
  gallery            String[]  @default([])
  /// Order in which products are listed when no sort is chosen.
  position           Int       @default(0)
  variants           Variant[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([category])
  @@index([brandId])
  @@index([position])
}

/// A shade of a product, with its own price and stock.
model Variant {
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  Int
  /// The shade's id within its product, e.g. "custard".
  key        String
  name       String
  /// Hex colour of the formula, for swatches.
  swatch     String
  priceCents Int
  stock      Int
  image      String?
  /// Order in which the shades are shown.
  position   Int

  @@id([productId, key])
}

enum OrderStatus {
  Placed
  Shipped
  Delivered
  Cancelled
}

enum PaymentMethod {
  Cash
}

/// An order as placed at checkout. Contact and address are copied in, so later changes to a
/// shopper's details never rewrite past orders.
model Order {
  /// Random and unguessable: the confirmation page is reached by this id alone.
  id            String        @id @default(cuid())
  /// Short reference shown to the shopper and the care team, e.g. "VB-7K2M9Q".
  reference     String        @unique
  status        OrderStatus   @default(Placed)
  paymentMethod PaymentMethod
  email         String
  firstName     String
  lastName      String
  phone         String
  area          String
  street        String
  building      String
  floor         String
  directions    String
  country       String
  latitude      Float?
  longitude     Float?
  promoCode     String?
  subtotalCents Int
  discountCents Int
  shippingCents Int
  totalCents    Int
  items         OrderItem[]
  /// The account that placed it, when the shopper was signed in.
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId        String?
  createdAt     DateTime      @default(now())

  @@index([email])
  @@index([userId])
  @@index([createdAt])
}

/// One line of an order. Name, brand, shade and price are a snapshot of the moment of purchase.
model OrderItem {
  id             Int     @id @default(autoincrement())
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  productId      Int
  variantKey     String?
  name           String
  brand          String
  shade          String?
  image          String?
  unitPriceCents Int
  quantity       Int

  @@index([orderId])
}

// Accounts: the four tables Better Auth needs (src/lib/auth.ts). Passwords are never stored
// as typed: Account.password holds a salted hash.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  sessions      Session[]
  accounts      Account[]
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// A signed-in browser. The token lives in an httpOnly cookie; deleting the row signs it out.
model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// How a user signs in: providerId "credential" is email and password.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Short-lived tokens, e.g. for email verification or password reset.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
